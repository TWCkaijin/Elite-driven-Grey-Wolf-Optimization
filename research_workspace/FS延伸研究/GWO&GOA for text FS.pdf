     <rdf:li>Preprocessing steps</rdf:li>
     <rdf:li>GWO</rdf:li>
     <rdf:li>GOA</rdf:li>
     <rdf:li>FCM</rdf:li>
     <rdf:li>And text clustering</rdf:li>
